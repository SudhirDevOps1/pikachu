# =============================================================================
# Pika AI Assistant — .gitignore
# Generated: 2026-08-24 | Keep repo lean, reproducible & secret-free
# =============================================================================

# ── Node / Electron / Vite builds ────────────────────────────────────────────
node_modules/
dist/
dist-electron/
dist-bin/
release/
build/
.pc_bridge_build/
*.tsbuildinfo
pc_bridge.spec
*.blockmap

# ── Python env, caches & bytecode ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Secrets & local config (NEVER commit) ────────────────────────────────────
.env
.env.local
.env.*.local
*.local
pika_data.json
pika_audit.jsonl
pc_bridge.log
*.pem
*.key

# ── Large models & downloads (use setup_models.py) ───────────────────────────
models/
*.zip
*.tar.gz
*.bin
*.gguf
!package.json

# ── Logs, media & temp ───────────────────────────────────────────────────────
logs/
temp/
tmp/
.screenshots/
screenshots/
*.tmp
*.log
*.mp3
*.wav
*.bak

# ── Scratch / patch / experiment scripts (not part of product) ───────────────
fix_*.py
fix.py
fix2.py
fix_banner*.py
fix_handle.py
patch.py
kill_*.py
write_engine.py
recovery*.txt
showcase.html

# Keep canonical test suite — do NOT ignore
!test_pc_bridge.py

# ── Lightweight throwaway tests (ignore, keep repo clean) ────────────────────
test_bridge.py
test_conn.py
test_ws.py
test_hf.py
test_*.bak

# ── Local notes (personal, not for repo) ─────────────────────────────────────
brain.md
details.md

# ── IDE & OS junk ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
