# ==============================================================================
# PIKA AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your own API keys.
# (All keys are optional. You can also configure them directly in the Web UI Settings)
# ==============================================================================

# LLM Providers (Multiple keys supported via comma-separation: key1,key2,key3)
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=

# Obsidian Second Brain Integration (Local REST API Plugin)
OBSIDIAN_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=

# Server Configuration
PIKA_HOST=0.0.0.0
PIKA_PORT=8765
